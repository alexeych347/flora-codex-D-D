generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Herb {
  id           String        @id @default(cuid())
  name         String
  latinName    String
  imageUrl     String?
  rarity       Rarity        @default(COMMON)
  discoveredAt String?
  description  String
  properties   String[]
  effects      String
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  access       HerbAccess[]
}

model Player {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  passwordHash String
  role         PlayerRole   @default(PLAYER)
  createdAt    DateTime     @default(now())
  access       HerbAccess[]
}

model HerbAccess {
  id       String @id @default(cuid())
  herbId   String
  playerId String
  herb     Herb   @relation(fields: [herbId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([herbId, playerId])
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  VERY_RARE
}

enum PlayerRole {
  PLAYER
  MASTER
}
